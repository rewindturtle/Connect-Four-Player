{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Book (Windows)",
			"type": "shell",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": [],
			"options": { 
				"cwd": "${workspaceFolder}/book"
			},
			"command": "cmake -S . -B build -G \"MinGW Makefiles\"; cmake --build build"
		}
	]
}
