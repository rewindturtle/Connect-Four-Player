{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Book (Windows)",
			"type": "shell",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": "$gcc",
			"options": {
				"cwd": "${workspaceFolder}/code/book",
				"env": {"PATH": "C:/msys64/mingw64/bin;${env:PATH}"},
			},
			"command": "cmake -S . -B build -G Ninja; cmake --build build"
		},
		{
			"label": "Build Desktop UI (Windows)",
			"type": "shell",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": "$gcc",
			"options": {
				"cwd": "${workspaceFolder}/code/desktop",
				"env": {"PATH": "C:/msys64/mingw64/bin;${env:PATH}"},
			},
			"command": "cmake -S . -B build -G Ninja; cmake --build build"
		}
	]
}
